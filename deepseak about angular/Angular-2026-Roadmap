### Testing Signals (NEW)

```typescript
describe('SignalService', () => {
  let service: SignalService;
  
  beforeEach(() => {
    TestBed.configureTestingModule({});
    service = TestBed.inject(SignalService);
  });
  
  it('should update signal', () => {
    service.count.set(0);
    service.count.update(v => v + 1);
    expect(service.count()).toBe(1);
  });
  
  it('should compute derived values', () => {
    service.count.set(5);
    expect(service.doubleCount()).toBe(10);
  });
  
  it('should trigger effects', (done) => {
    let effectRan = false;
    effect(() => {
      if (service.count() > 0) effectRan = true;
    });
    
    service.count.set(1);
    setTimeout(() => {
      expect(effectRan).toBe(true);
      done();
    }, 0);
  });
});
```

