### Project 2: User Management with Signal Forms

```typescript
// 2026 form-based app: Pure Signal Forms + Service pattern

interface User {
  id: string;
  firstName: string;
  lastName: string;
  email: string;
  role: 'user' | 'admin';
}

// Service: Business logic + signals
@Injectable({ providedIn: 'root' })
export class UserManagementService {
  users = signal<User[]>([]);
  selectedUser = signal<User | null>(null);
  isLoading = signal(false);
  error = signal<string | null>(null);
  
  // Computed derived state
  isAdmin = computed(() => {
    return this.selectedUser()?.role === 'admin';
  });
  
  userCount = computed(() => this.users().length);
  
  constructor(private http: HttpClient) {
    this.loadUsers();
  }
  
  private loadUsers() {
    this.isLoading.set(true);
    this.http.get<User[]>('/api/users')
      .pipe(
        tap(users => this.users.set(users)),
        catchError(err => {
          this.error.set(err.message);
          return of([]);
        }),
        finalize(() => this.isLoading.set(false))
      )
      .subscribe();
  }
  
  saveUser(user: User) {
    return this.http.post('/api/users', user)
      .pipe(tap(() => {
        // Update list after save
        this.users.update(current => [...current, user]);
      }));
  }
}

// Component: Only UI logic, uses service + forms
@Component({
  selector: 'app-user-form',
  standalone: true,
  imports: [CommonModule, FormsModule],
  template: `
