        [(ngModel)]="user().email" 
        placeholder="Email"
        type="email">
      
      @if (isAdmin()) {
        <p>Admin user - full permissions</p>
      }
      
      <button [disabled]="isLoading() || !isValid()">
        {{ isLoading() ? 'Saving...' : 'Save' }}
      </button>
      
      @if (error()) {
        <p class="error">{{ error() }}</p>
      }
    </form>
  `,
  changeDetection: ChangeDetectionStrategy.OnPush
})
export class UserFormComponent implements OnInit {
  user = model<User>({ 
    id: '', firstName: '', lastName: '', email: '', role: 'user' 
  });
  
  isEditing = signal(false);
  isLoading = inject(UserManagementService).isLoading;
  error = inject(UserManagementService).error;
  isAdmin = inject(UserManagementService).isAdmin;
  
