```typescript
// CONSOLIDATED IN 2026: No more *ngIf, *ngFor, *ngSwitch

@Component({
  template: `
    @if (isLoading()) {
      <p>Loading...</p>
    } @else if (hasError()) {
      <p>Error: {{ error() }}</p>
    } @else {
      <div>
        @for (let item of items(); track item.id) {
          <app-item [item]="item"></app-item>
        }
      </div>
    }
    
    @switch (status()) {
      @case ('pending') { <p>Pending...</p> }
      @case ('done') { <p>Complete!</p> }
      @default { <p>Unknown status</p> }
    }
  `
})
export class ModernComponent {
  items = signal<Item[]>([]);
  isLoading = signal(false);
  error = signal<string | null>(null);
  status = signal('pending');
}
```

