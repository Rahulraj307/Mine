# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
# For local MongoDB: mongodb://localhost:27017/taskmaster
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/taskmaster
MONGODB_URI=mongodb://localhost:27017/taskmaster

# JWT Secrets (Generate strong secrets for production!)
# You can generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Token Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:4200
